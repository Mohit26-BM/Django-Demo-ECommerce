# Copy this file to .env for local development. .env is git-ignored and never published.
DEBUG=True
# Optional locally; REQUIRED when DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# Comma separated. Needed when DEBUG is off (on Render the host name is added automatically).
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Optional: path of the SQLite file (for a persistent disk on a host)
# SQLITE_PATH=
